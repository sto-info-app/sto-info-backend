{
  "name": "sto-info-backend",
  "version": "1.4.24",
  "description": "Star Trek Online Information APIs",
  "author": "Steve Roberts",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sto-info-app/sto-info-backend.git"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "clean": "rimraf dist",
    "assets:copy": "ts-node -r tsconfig-paths/register src/views/copy-email-templates-to-dist.ts",
    "build": "npm run clean && nest build && npm run assets:copy",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./config/typeorm.datasource.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./config/typeorm.datasource.ts",
    "migration:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d ./config/typeorm.datasource.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./config/run-typeorm.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "start": "cross-env TZ=UTC node dist/src/main",
    "start:prod": "cross-env TZ=UTC node dist/src/main",
    "start:render": "npm run migration:run && npm run start:prod",
    "start:dev": "npm run assets:copy && cross-env TZ=UTC nest start --watch",
    "watch": "npm run start:dev",
    "start:watch": "npm run start:dev",
    "start:debug": "cross-env TZ=UTC nest start --debug --watch",
    "start:dist": "npm run build && npm run migration:run && npm run start:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns='.fuzz.spec.ts'",
    "test:fuzz": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules FUZZ_NUM_RUNS=${FUZZ_NUM_RUNS:-50} jest --config jest.config.mjs --testRegex='.*\\.fuzz\\.spec\\.ts$' --coverage=false",
    "test:fuzz:full": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules FUZZ_NUM_RUNS=${FUZZ_NUM_RUNS:-1000} jest --testRegex='.*\\.fuzz\\.spec\\.ts$' --coverage=false",
    "test:watch": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "cross-env TZ=UTC NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=8192 --disable-warning=ExperimentalWarning\" jest --config jest.config.mjs --runInBand --coverage --coverageDirectory=reports/coverage --testPathIgnorePatterns='.fuzz.spec.ts'",
    "test:debug": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "e2e": "npm run test:e2e",
    "e2e:support": "ts-node -r tsconfig-paths/register scripts/e2e-support.ts",
    "fixtures:fleet-corpus": "ts-node -r tsconfig-paths/register scripts/generate-fleet-corpus-fixtures.ts",
    "rehearse:migration": "bash scripts/migration-rehearsal/run-rehearsal.sh",
    "rehearse:migration:fleet-authorisation": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1791600000000-CreateFleetCommunityDomainTables.ts,src/database/migrations/1791700000000-CreateScopeCapabilityGrants.ts fleet-authorisation",
    "rehearse:migration:user-preferences": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1791800000000-CreateUserPreference.ts,src/database/migrations/1791900000000-SeedFleetFeatureSwitch.ts user-preferences",
    "rehearse:migration:calendar-dates": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1792000000000-UseCalendarDatesForEnteredDays.ts calendar-dates",
    "probe:asset-delivery": "node scripts/asset-delivery-probe/probe.mjs",
    "rehearse:migration:file-assets": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1791600000000-CreateFleetCommunityDomainTables.ts,src/database/migrations/1792100000000-CreateFileAssets.ts,src/database/migrations/1792200000000-BackfillLegacyFileAssets.ts file-assets",
    "rehearse:migration:file-asset-placements": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1792600000000-CreateFileAssetPlacements.ts file-asset-placements",
    "rehearse:migration:w03-registration": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1791600000000-CreateFleetCommunityDomainTables.ts,src/database/migrations/1792700000000-ScopeSlugsByPlatform.ts,src/database/migrations/1792800000000-LimitFleetCommunitiesPerOwner.ts,src/database/migrations/1792900000000-CreateFleetSlugHistory.ts w03-registration",
    "rehearse:migration:declared-content-types": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1792400000000-NormaliseDeclaredContentTypes.ts declared-content-types",
    "rehearse:migration:roster-import-source": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1791600000000-CreateFleetCommunityDomainTables.ts,src/database/migrations/1792100000000-CreateFileAssets.ts,src/database/migrations/1792300000000-CreateRosterImportSource.ts,src/database/migrations/1792500000000-AddDeclaredContentTypeToRosterImportSource.ts roster-import-source",
    "test:mutation": "stryker run --reporters clear-text --reporters html --reporters progress",
    "test:mutation:dry": "stryker run --reporters clear-text --reporters html --reporters progress --dryRunOnly",
    "test:mutation:incremental": "node ./scripts/run-incremental-mutation.mjs",
    "summary:ci": "node scripts/generate-ci-summary.mjs",
    "verify": "npm audit --audit-level=high --omit=dev && npm run lint && npm run format:check && npm run test:cov && npm run test:fuzz && npm run build",
    "postinstall": "node scripts/patch-nested-packages.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-secrets-manager": "^3.1131.0",
    "@aws-sdk/client-sesv2": "^3.1131.0",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^12.0.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nestjs": "^10.74.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-glob": "^3.3.3",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nestjs-cls": "^6.3.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "rate-limit-redis": "^6.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-themes": "^3.0.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.2",
    "@nestjs/testing": "^12.0.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "fast-check": "^4.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ]
  },
  "jest-junit": {
    "suiteName": "sto-info-backend",
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml",
    "addFileAttribute": "true",
    "usePathForSuiteName": "true"
  }
}
