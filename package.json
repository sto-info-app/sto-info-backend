{
  "name": "sto-info-backend",
  "version": "1.0.40",
  "description": "Star Trek Online Information APIs",
  "author": "Steve Roberts",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/steverobertsuk/sto-info-backend.git"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "clean": "rimraf dist",
    "assets:copy": "ts-node -r tsconfig-paths/register src/views/copy-email-templates-to-dist.ts",
    "build": "npm run clean && nest build && npm run assets:copy",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./config/typeorm.datasource.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./config/typeorm.datasource.ts",
    "migration:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d ./config/typeorm.datasource.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./config/run-typeorm.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "start": "cross-env TZ=UTC node dist/src/main",
    "start:prod": "cross-env TZ=UTC node dist/src/main",
    "start:render": "npm run migration:run && npm run start:prod",
    "start:dev": "npm run assets:copy && cross-env TZ=UTC nest start --watch",
    "start:watch": "npm run start:dev",
    "start:debug": "cross-env TZ=UTC nest start --debug --watch",
    "start:dist": "npm run build && npm run migration:run && npm run start:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "cross-env TZ=UTC jest",
    "test:watch": "cross-env TZ=UTC jest --watch",
    "test:cov": "cross-env TZ=UTC jest --config jest.config.mjs --runInBand --coverage --coverageDirectory=reports/coverage --coverageReporters=lcov --coverageReporters=text-summary",
    "test:debug": "cross-env TZ=UTC node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env TZ=UTC jest --config ./test/jest-e2e.json",
    "test:mutation": "stryker run --reporters clear-text --reporters html --reporters progress",
    "test:mutation:dry": "stryker run --reporters clear-text --reporters html --reporters progress --dryRunOnly"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/client-secrets-manager": "^3.978.0",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.4",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sendgrid/mail": "^8.1.3",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudmersive-virus-api-client": "^1.4.0",
    "cross-env": "^10.1.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "fast-glob": "^3.3.2",
    "helmet": "^8.1.0",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nestjs-cls": "^6.2.0",
    "nodemailer": "^7.0.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.17.2",
    "rate-limit-redis": "^4.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "superagent": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "swagger-ui-themes": "^3.0.1",
    "ts-node-dev": "^2.0.0",
    "typeorm": "^0.3.27",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.23.0",
    "@eslint/object-schema": "^3.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.12",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/jest-runner": "^9.4.0",
    "@stryker-mutator/typescript-checker": "^9.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.1.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "glob": "^13.0.0",
    "globals": "^17.2.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.5",
    "ts-loader": "^9.5.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "diff": "^8.0.3",
    "lodash": "^4.17.23"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "tsconfig.json",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@typescript-eslint/recommended-requiring-type-checking",
      "plugin:prettier/recommended"
    ],
    "husky": {
      "hooks": {
        "pre-commit": "lint-staged"
      }
    }
  }
}
