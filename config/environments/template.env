#NOTE: Add *ALL* variables to the config-check.service.ts
#NOTE: The app will throw an error if env vars missing/invalid.
#NOTE: This will assist if variables are missing upon release!

NODE_ENV=local

LOG_LEVEL=log

APP_PORT=3000
APP_FRONTEND_URL=http://localhost:4200
APP_TITLE="Star Trek Online Info Portal"

AUTH_SALT_ROUNDS=10
AUTH_TOKEN_EXPIRES_IN=3600 #NOTE: This is in seconds, so 3600 seconds = 1 hour
AUTH_REFRESH_TOKEN_EXPIRES_IN=14400 #NOTE: This is in seconds, so 14400 seconds = 4 hours

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sto_info_app_local
DB_SCHEMA=sto_info_app
DB_USERNAME=postgres
DB_SSL_REJECT_UNAUTHORIZED=false

REDIS_URL=redis://localhost:6379

TYPEORM_SYNCHRONIZE=false #NOTE: Ensure synchronize is set to false for migrations
TYPEORM_LOGGING=false
TYPEORM_ENTITIES='src/**/*.entity.{js,ts}'
TYPEORM_MIGRATIONS='src/database/migrations/*.{js,ts}'

SENDGRID_NOREPLY_SENDER=no-reply@startrekonline.info

#NOTE: The AWS credentials will need to contain the sensitive information as described in the README.
AWS_ACCESS_KEY_ID='YOUR_AWS_ACCESS_KEY_ID'
AWS_SECRET_ACCESS_KEY='YOUR_AWS_SECRET_ACCESS_KEY'
AWS_REGION='YOUR_AWS_REGION'
AWS_SECRET_NAME='YOUR_AWS_SECRET_NAME'

#NOTE: The following variables are for the seed user. This user will be created when the app is first run.
DATASEED_USER_EMAIL='user@example.com'
DATASEED_USER_USERNAME='YourUsername'
DATASEED_USER_FIRSTNAME='YourFirstName'
DATASEED_USER_LASTNAME='YourLastName'
DATASEED_USER_PASSWORD='YourPassword'

CLOUDFLARE_R2_ENDPOINT='https://your-account-id.r2.cloudflarestorage.com'
CLOUDFLARE_R2_BUCKET_NAME='your-bucket-name'
CLOUDFLARE_CDN_ROOT_URL='https://cdn.yourdomain.com'
CLOUDFLARE_IMAGES_HASH='your-images-hash'

MAX_IMAGE_SIZE_IN_BYTES=10485760 #NOTE: 10MB in (binary) bytes

AUDIT_DATA_NUKE_THRESHOLD_DAYS=3
AUDIT_IP_NUKE_THRESHOLD_DAYS=1

TRUST_PROXY_HOPS=1 #NOTE: Number of proxy hops to trust (e.g., Cloudflare as a proxy) [Optional; Default: 1]

# Optional diagnostics
STARTUP_DIAGNOSTICS=false #NOTE: When true, logs memory usage at key startup stages
