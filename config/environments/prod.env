NODE_ENV=prod

APP_PORT=3000
APP_FRONTEND_URL=https://startrekonline.info
APP_TITLE="Star Trek Online Info Portal"

AUTH_SALT_ROUNDS=10

DB_TYPE=postgres
DB_HOST=sto-info-dev-database.chjqtkzmlpuz.eu-west-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=sto_info_app_prod
DB_SCHEMA=sto_info_app
DB_USERNAME=sto_info_db_user

TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false
TYPEORM_MIGRATIONS=src/migrations/*.ts
TYPEORM_MIGRATIONS_DIR=src/migrations

SENDGRID_NOREPLY_SENDER=no-reply@startrekonline.info

AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
AWS_REGION=eu-west-2
AWS_SECRET_NAME=sto_info_app_prod
