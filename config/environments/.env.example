# Application Environment
NODE_ENV=dev # Options: local, dev, staging, prod

# Application Port
APP_PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-password
DB_DATABASE=sto_info_db

# Logging Configuration
# LOG_LEVEL controls what logs are output
# Options (from least to most verbose):
#   error   - Only errors
#   warn    - Errors and warnings
#   log     - Errors, warnings, and important logs (default)
#   debug   - All of the above plus debug information
#   verbose - All logs including very detailed information
#
# You can also specify multiple levels: LOG_LEVEL=error,warn,log
# Or use a single level to enable it and all levels below it: LOG_LEVEL=debug
#
# For production, use: LOG_LEVEL=error,warn
# For development with full debugging: LOG_LEVEL=debug
# For troubleshooting with maximum detail: LOG_LEVEL=verbose
LOG_LEVEL=log


# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# AWS Configuration (for Secrets Manager)
AWS_REGION=us-east-1
AWS_SECRET_NAME=your-secret-name

# Cloudflare Configuration
CLOUDFLARE_R2_ENDPOINT='https://your-account-id.r2.cloudflarestorage.com'
CLOUDFLARE_R2_BUCKET_NAME='your-bucket-name'
CLOUDFLARE_CDN_ROOT_URL='https://cdn.yourdomain.com'
CLOUDFLARE_IMAGES_HASH='your-images-hash'

# File Upload Limits
MAX_IMAGE_SIZE_IN_BYTES=10485760 # 10MB

# Trust Proxy (for rate limiting behind Cloudflare)
TRUST_PROXY_HOPS=1
