# Application Environment
NODE_ENV=local # Options: local, dev, staging, prod
LOG_LEVEL=log # error,warn,log,debug,verbose (optionally comma-separated)

# Application
APP_PORT=3000
APP_FRONTEND_URL=http://localhost:4200
APP_TITLE="Star Trek Online Info Portal"

# Authentication
AUTH_SALT_ROUNDS=10
AUTH_TOKEN_EXPIRES_IN=3600
AUTH_REFRESH_TOKEN_EXPIRES_IN=14400

# Database (Postgres)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sto_info_app_example_db
DB_SCHEMA=sto_info_app_example_schema
DB_USERNAME=postgres
DB_SSL_REJECT_UNAUTHORIZED=false

# Redis (Rate Limiting)
REDIS_URL=redis://localhost:6379

# TypeORM
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false
TYPEORM_ENTITIES='src/**/*.entity.{js,ts}'
TYPEORM_MIGRATIONS='src/database/migrations/*.{js,ts}'

# Mail
EMAIL_NOREPLY_SENDER=no-reply@startrekonline.info

# AWS (Secrets Manager)
# NOTE: Secrets (JWT secret, dbPassword, Cloudflare R2 keys, Cloudmersive key, etc.) are pulled from the secret referenced by AWS_SECRET_NAME.
AWS_ACCESS_KEY_ID='YOUR_AWS_ACCESS_KEY_ID'
AWS_SECRET_ACCESS_KEY='YOUR_AWS_SECRET_ACCESS_KEY'
AWS_REGION='YOUR_AWS_REGION'
AWS_SECRET_NAME='YOUR_AWS_SECRET_NAME'
AWS_SNS_TOPIC_ARN='YOUR_SNS_TOPIC_ARN'
AWS_SES_CONFIGURATION_SET='YOUR_SES_CONFIGURATION_SET_NAME'

# Optional seed user (used on first run in some environments)
DATASEED_USER_EMAIL='user@example.com'
DATASEED_USER_USERNAME='YourUsername'
DATASEED_USER_FIRSTNAME='YourFirstName'
DATASEED_USER_LASTNAME='YourLastName'
DATASEED_USER_PASSWORD='YourPassword'

# Cloudflare
CLOUDFLARE_R2_ENDPOINT='https://your-account-id.r2.cloudflarestorage.com'
CLOUDFLARE_R2_BUCKET_NAME='your-bucket-name'
CLOUDFLARE_CDN_ROOT_URL='https://cdn.yourdomain.com'
CLOUDFLARE_IMAGES_HASH='your-images-hash'

# File upload limits
MAX_IMAGE_SIZE_IN_BYTES=10485760

# Audit cleanup (days)
AUDIT_DATA_NUKE_THRESHOLD_DAYS=3
AUDIT_IP_NUKE_THRESHOLD_DAYS=1
CONTACT_REQUEST_EMAIL_MASK_RETENTION_DAYS=21
CONTACT_REQUEST_RECORD_RETENTION_DAYS=90
CLOSED_ACCOUNT_RETENTION_DAYS=180
SES_AUDIT_RETENTION_DAYS=180
SES_SUPPRESSION_RETENTION_DAYS=2557

# Trust proxy (for rate limiting behind Cloudflare)
TRUST_PROXY_HOPS=1

# Optional diagnostics
STARTUP_DIAGNOSTICS=false

# Sentry (optional) - used for error tracking
SENTRY_DSN=''
